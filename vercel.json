{
  "redirects": [
    { "source": "/home", "destination": "/", "permanent": true },
    { "source": "/app", "destination": "/app/", "permanent": true }
  ],
  "rewrites": [
    { "source": "/c/:code", "destination": "/c/index.html" },
    { "source": "/privacy", "destination": "/privacy/index.html" },
    { "source": "/community", "destination": "/community/index.html" },
    { "source": "/u/:name", "destination": "/u/index.html" },
    { "source": "/account", "destination": "/account/index.html" }
  ],
  "git": {
    "deploymentEnabled": {
      "**": false,
      "main": true
    }
  }
}
